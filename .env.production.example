# Copy this file to .env.production on the server and fill in strong secrets.

NODE_ENV=production
PORT=3000

MYSQL_ROOT_PASSWORD=CHANGE_ME_use_strong_password_here
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=CHANGE_ME_use_strong_password_here
DB_NAME=my_blog

JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_to_generate
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=blog_refresh_token

REDIS_URL=redis://redis:6379
REDIS_PREFIX=blog

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=blog_articles

LLM_PROVIDER=pseudo
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=pseudo-rag

CORS_ORIGIN=https://your-domain.example
